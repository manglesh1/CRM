{
  "name": "movira-crm",
  "version": "0.1.0",
  "description": "Movira CRM communication service for transactional messaging and marketing CRM.",
  "main": "src/server.js",
  "scripts": {
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "seed": "npx sequelize-cli db:seed:all",
    "seed:undo": "npx sequelize-cli db:seed:undo",
    "predev": "npm run migrate && npm run seed",
    "worker:transactional": "cross-env MOVIRA_COMPONENT=transactional-worker node src/workers/transactionalWorker.js",
    "worker:marketing": "cross-env MOVIRA_COMPONENT=marketing-worker node src/workers/marketingWorker.js",
    "worker:marketing-audience": "cross-env MOVIRA_COMPONENT=marketing-audience-worker node src/workers/marketingAudienceWorker.js",
    "worker:webhooks": "cross-env MOVIRA_COMPONENT=webhooks-worker node src/workers/sesWebhookWorker.js",
    "worker:warmup": "cross-env MOVIRA_COMPONENT=warmup-worker node src/workers/senderWarmupWorker.js",
    "worker:contacts": "cross-env MOVIRA_COMPONENT=contacts-worker node src/workers/contactsWorker.js",
    "worker:segments": "cross-env MOVIRA_COMPONENT=segments-worker node src/workers/segmentsWorker.js",
    "worker:automation": "cross-env MOVIRA_COMPONENT=automation-worker node src/workers/automationWorker.js",
    "start": "node src/server.js",
    "dev:api": "cross-env MOVIRA_COMPONENT=api nodemon src/server.js",
    "dev": "concurrently -n \"api,tx,mk,ma,wh,wu,cw,sw,aw\" \"npm run dev:api\" \"npm run worker:transactional\" \"npm run worker:marketing\" \"npm run worker:marketing-audience\" \"npm run worker:webhooks\" \"npm run worker:warmup\" \"npm run worker:contacts\" \"npm run worker:segments\" \"npm run worker:automation\"",
    "test": "node --test"
  },
  "keywords": [
    "movira",
    "crm",
    "communications",
    "transactional",
    "marketing"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/client-sesv2": "^3.1041.0",
    "@aws-sdk/client-sns": "^3.1041.0",
    "@aws-sdk/client-sqs": "^3.1041.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.7",
    "pg": "^8.14.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.2"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  }
}
